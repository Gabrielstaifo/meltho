---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.ts';
---

<Base
  title="عن المشروع"
  description={`عن مشروع ${site.name}: نشر ترجمات عربية لنصوص آباء الكنيسة السريانية، عرضاً متوازياً فقرة مقابل فقرة.`}
  isAbout
>
  <article>
    <h1 class="page-title">عن المشروع</h1>

    <section>
      <h2 class="section-heading">ما هذا الموقع؟</h2>
      <p>
        {site.name}
        ({site.name_syr}) موقع لنشر ترجمات عربية لكتابات آباء الكنيسة السريانية وصلواتها وترانيمها.
        يُعرض فيه النص السرياني الأصلي والترجمة العربية جنباً إلى جنب، فقرة مقابل فقرة، ليتمكن
        القارئ من المقارنة بينهما مباشرة.
      </p>
      <p>
        صُمّم الموقع للقراءة على الهاتف أولاً، لأن معظم القرّاء يصلون إليه عبر روابط على وسائل
        التواصل. على الشاشات العريضة يظهر عمودان، وعلى الهاتف يظهر النص السرياني ثم الترجمة
        العربية تحته.
      </p>
    </section>

    <section>
      <h2 class="section-heading">أمانة النص</h2>
      <p>
        المحتوى كله من عمل المترجم، ولا يُعدَّل النص السرياني ولا الترجمة العربية آلياً. ولا
        يُحافَظ تلقائياً على التشكيل والتنقيط فحسب، بل يُترك النص كما كتبه صاحبه. التحويل الوحيد
        المسموح به هو حذف التطويل (الكشيدة) عند العرض، لأنه ناتج عن المحاذاة ولا يخص النص نفسه.
      </p>
      <p>
        لا يستخدم الموقع ترجمة آلية ولا توليد نصوص بالذكاء الاصطناعي، ولا توجد فيه حسابات
        مستخدمين ولا تعليقات ولا قاعدة بيانات. الموقع ثابت بالكامل.
      </p>
    </section>

    <section>
      <h2 class="section-heading">كيف تُضاف مقالة؟</h2>
      <p>
        كل مقالة ملف نصي واحد، وفي أعلاه بياناتها: العنوان، والأب صاحب النص، والعمل الأصلي،
        والمصدر، والمترجم، وتاريخ الترجمة، والحالة. ثم يأتي المتن مقسّماً إلى أزواج: فقرة سريانية
        تليها فقرة عربية مقابلة لها.
      </p>
    </section>

    <section>
      <h2 class="section-heading">ملاحظة</h2>
      <p>
        اسم المشروع الحالي مؤقت، وكذلك النطاق، ويمكن تغييرهما من مكان واحد دون تعديل بقية الموقع.
      </p>
    </section>
  </article>
</Base>
