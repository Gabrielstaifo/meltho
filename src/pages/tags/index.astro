---
import Base from '../../layouts/Base.astro';
import { getVisibleArticles } from '../../lib/articles.ts';
import { groupByTag } from '../../lib/taxonomy.ts';
import { site, tagPath } from '../../config/site.ts';

const groups = groupByTag(await getVisibleArticles());
---

<Base title="الوسوم" description={site.tagline_ar} isTags>
  <h1 class="page-title">الوسوم</h1>

  {
    groups.length === 0 ? (
      <p class="empty-note">لا توجد مقالات منشورة بعد.</p>
    ) : (
      <ul class="term-list">
        {groups.map((group) => (
          <li>
            <a class="term-card" href={tagPath(group.slug)}>
              <span class="term-card__name">{group.tag.label_ar}</span>
              <span class="term-card__count">({group.articles.length})</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
