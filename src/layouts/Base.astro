---
import { absoluteUrl, paths, site, withBase } from '../config/site.ts';
import '../styles/fonts.css';
import '../styles/syriac-fonts.css';
import '../styles/global.css';

interface Props {
  /** Page title without the site name; omitted on the home page. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  /** ISO date of publication/translation, for article pages. */
  publishedTime?: string;
  /** True on the article index, so the nav item can be marked. */
  isArticles?: boolean;
  isAbout?: boolean;
  /** True on a fathers page, so the nav item can be marked. */
  isFathers?: boolean;
  /** True on a tags page, so the nav item can be marked. */
  isTags?: boolean;
}

const {
  title,
  description = site.tagline_ar,
  type = 'website',
  image = 'og-default.png',
  publishedTime,
  isArticles = false,
  isAbout = false,
  isFathers = false,
  isTags = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline_ar}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = absoluteUrl(image);
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('favicon.svg')} />

    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf6ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1713" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.tagline_ar} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted fonts: preload what the first screen needs -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('fonts/serto-urhoy-400.woff2')}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={withBase('fonts/amiri-400-arabic.woff2')}
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">تجاوز إلى المحتوى</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={paths.home}>
          <span class="brand__name">{site.name}</span>
          <span class="brand__syr" lang="syr" dir="rtl">{site.name_syr}</span>
        </a>
        <nav class="site-nav" aria-label="التنقل الرئيسي">
          <a href={paths.home} aria-current={isArticles ? 'page' : undefined}>المقالات</a>
          <a href={paths.fathers} aria-current={isFathers ? 'page' : undefined}>الآباء</a>
          <a href={paths.tags} aria-current={isTags ? 'page' : undefined}>الوسوم</a>
          <a href={paths.about} aria-current={isAbout ? 'page' : undefined}>عن المشروع</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="site-footer__name">{site.name}</p>
        <p>{site.tagline_ar}</p>
      </div>
    </footer>
  </body>
</html>
