---
import type { Article } from '../lib/articles.ts';
import { isoDate } from '../lib/articles.ts';
import { articlePath, fatherPath } from '../config/site.ts';
import { fatherName } from '../config/fathers.ts';
import TagList from './TagList.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title_ar, title_syr, author_slug, work, summary_ar, tags, status, translation_date } =
  article.data;
const isPublished = status === 'published';
const statusLabel = status === 'draft' ? 'مسودة' : 'روجعت';
---

<li>
  <article class="article-card">
    <h2 class="article-card__title">
      <a class="article-card__link" href={articlePath(article.id)}>
        {title_ar}
      </a>
      {!isPublished && <span class="status-badge">{statusLabel}</span>}
    </h2>
    <p class="article-card__meta">
      <span>
        <a href={fatherPath(author_slug)}>{fatherName(author_slug)}</a>
      </span>
      <span>{work}</span>
      <time datetime={isoDate(translation_date)}>{isoDate(translation_date)}</time>
    </p>
    {title_syr && <p class="article-card__syr" lang="syr" dir="rtl">{title_syr}</p>}
    <p class="article-card__summary">{summary_ar}</p>
    <TagList tags={tags} />
  </article>
</li>
